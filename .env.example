# Copy this file to .env and adjust if needed.
# .env is gitignored and never committed.
#
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# "db" is the Postgres service name in docker-compose.yml, NOT localhost —
# Docker's internal DNS resolves service names to the right container.
DATABASE_URL=postgresql://taskuser:taskpass@db:5432/taskdb
